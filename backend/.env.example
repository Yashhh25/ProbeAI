# ==============================================================================
# ProbeAI Backend Environment Configuration Example
# ==============================================================================

# Server Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port (Render and Cloud platforms automatically inject PORT)
PORT=5000

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/probeai?retryWrites=true&w=majority

# JWT Authentication (secret must be at least 8 characters)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# OpenRouter AI Provider Configuration
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini

# Allowed Frontend Origins for CORS (comma-separated for multiple domains)
# Example: https://probeai.vercel.app,https://yourdomain.com
CLIENT_URL=https://probeai.vercel.app
